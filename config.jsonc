{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/my-logo.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "left": 4,
      "right": 4
    },
    "color": {
      "1": "yellow",
      "2": "blue"
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "custom",
      "format": "\u001b[34m╭─ 󰣇 System ─────────────────────────╮\u001b[0m"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    {
      "type": "custom",
      "format": "\u001b[34m╰────────────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[34m╭─  Desktop ────────────────────────╮\u001b[0m"
    },
    "wm",
    "de",
    "shell",
    "terminal",
    {
      "type": "custom",
      "format": "\u001b[34m╰────────────────────────────────────╯\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[34m╭─  Hardware ───────────────────────╮\u001b[0m"
    },
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    {
      "type": "custom",
      "format": "\u001b[34m╰────────────────────────────────────╯\u001b[0m"
    },
    "break",
    "colors"
  ]
}
